{
  "permissions": {
    "allow": ["Bash(dotnet build:*)", "Bash(gh pr diff:*)"],
    "deny": ["Bash(git commit:*)", "Bash(git add:*)", "Bash(git push:*)"]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "mcpServers": {
    "splunk": {
      "command": "node",
      "args": ["${SPLUNK_MCP_DIR}/typescript/server.js"],
      "env": {
        "TRANSPORT": "stdio",
        "SPLUNK_HOST": "splunk.getty.cloud",
        "SPLUNK_PORT": "8089",
        "SPLUNK_TOKEN": "${SPLUNK_API_TOKEN}",
        "VERIFY_SSL": "true",
        "SPL_RISK_TOLERANCE": "100"
      }
    }
  }
}
