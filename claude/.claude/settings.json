{
  "permissions": {
    "allow": ["Bash(dotnet build:*)", "Bash(gh pr diff:*)"],
    "deny": ["Bash(git commit:*)", "Bash(git add:*)", "Bash(git push:*)"]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "robot-sheriff@getty-claude-marketplace": true,
    "anchor@getty-claude-marketplace": true,
    "ClaudeWatch@getty-claude-marketplace": true,
    "shipshape@getty-claude-marketplace": true,
    "getty-apps@getty-claude-marketplace": true,
    "uni-tools@getty-claude-marketplace": true,
    "sales-tools@getty-claude-marketplace": true,
    "sf-skills@getty-claude-marketplace": true
  },
  "extraKnownMarketplaces": {
    "getty-claude-marketplace": {
      "source": {
        "source": "url",
        "url": "https://ai-tools.pages.getty.cloud/claude/marketplace.json"
      }
    }
  },
  "theme": "dark",
  "mcpServers": {
    "splunk": {
      "command": "node",
      "args": ["${SPLUNK_MCP_DIR}/typescript/server.js"],
      "env": {
        "TRANSPORT": "stdio",
        "SPLUNK_HOST": "splunk.getty.cloud",
        "SPLUNK_PORT": "8089",
        "SPLUNK_TOKEN": "${SPLUNK_API_TOKEN}",
        "VERIFY_SSL": "true",
        "SPL_RISK_TOLERANCE": "100"
      }
    }
  }
}
